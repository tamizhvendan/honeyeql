{:paths ["src"]
 :deps  {org.clojure/clojure    {:mvn/version "1.12.6"}
         com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
         inflections/inflections            {:mvn/version "0.15.0"}
         edn-query-language/eql {:mvn/version "2025.09.27"}
         com.github.seancorfield/honeysql {:mvn/version "2.7.1437"}
         org.clojure/data.json  {:mvn/version "2.5.1"}}
 :aliases {:dev {:extra-paths ["dev"]
                 :extra-deps {com.mysql/mysql-connector-j {:mvn/version "9.7.0"}
                              org.postgresql/postgresql   {:mvn/version "42.7.13"}
                              hikari-cp/hikari-cp {:mvn/version "3.0.1"}
                              djblue/portal {:mvn/version "0.67.2"}}}
           :test {:extra-paths ["test"]
                  :main-opts ["-m" "cognitect.test-runner"]
                  :exec-fn cognitect.test-runner.api/test
                  :extra-deps {hikari-cp/hikari-cp {:mvn/version "3.0.1"}
                               com.mysql/mysql-connector-j {:mvn/version "9.7.0"}
                               org.postgresql/postgresql   {:mvn/version "42.7.13"}
                               io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}}}